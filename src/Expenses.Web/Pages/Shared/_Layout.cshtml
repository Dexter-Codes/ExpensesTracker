<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Expenses</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar"><a class="brand" asp-page="/Index"><span class="brand-mark">÷</span> expenses<span class="brand-dot">.</span></a><nav aria-label="Account"><partial name="_LoginPartial" /></nav></header>
    <main>@RenderBody()</main>
    <footer class="footer">A clear view of what’s shared. <span>Made for everyday life.</span></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
